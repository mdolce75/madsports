# Variables de producción. Copiar a deploy/.env (fuera de git) en el servidor y completar:  cp .env.example .env
# Nunca subir deploy/.env al repositorio.

# --- Base de datos (PostgreSQL del docker-compose) ---
# Una clave larga al azar: openssl rand -base64 24
DB_PASSWORD=

# --- Direcciones de cada sitio ---
APP_BASE_URL=https://madsports.com.ar
APP_URL_MADSPORTS=https://madsports.com.ar
APP_URL_RINKREPORTS=https://rinkreports.com.ar
APP_URL_RINKMETRICS=https://rinkmetrics.com.ar

# --- Mails (Resend) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# La API key de Resend (empieza con re_)
SMTP_PASSWORD=
MAIL_FROM=MadSports <info@madsports.com.ar>

# --- "Recordarme": una clave fija para que no se pierdan las sesiones recordadas al reiniciar ---
# openssl rand -base64 32
REMEMBER_ME_KEY=

# --- Opcional ---
# Análisis con IA (Google AI Studio). Vacío: análisis por reglas.
GEMINI_API_KEY=
# Quién recibe un aviso de cada registro nuevo (por defecto info@madsports.com.ar). Vacío: nadie.
# SIGNUP_NOTIFY_EMAIL=info@madsports.com.ar
# Quién recibe las alertas del chequeo diario de SIDGAD. Vacío: solo en el log.
ALERTS_EMAIL=
