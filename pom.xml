<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <!--
      Mad Sports: sus productos RinkReports (informes) y RinkMetrics (métricas en vivo). Un módulo por capa; cada uno
      solo usa los de abajo (Maven no compila un import de un módulo que no declaró):
        hockey-data   SIDGAD, clubes, categorías, planteles y estadísticas
        platform      cuentas, seguridad, mails, planes, plantillas a PDF      (usa hockey-data)
        rinkreports   informes de club y de jugador, Excel, análisis con IA     (usa platform)
        rinkmetrics   partidos en vivo del cuerpo técnico                       (usa platform)
        app           la aplicación: junta todo, configuración, migraciones y tests
    -->
    <groupId>com.madsports</groupId>
    <artifactId>madsports</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>madsports</name>
    <description>Mad Sports: métricas, estadísticas e informes de hockey sobre patines (RinkReports y RinkMetrics)</description>

    <modules>
        <module>hockey-data</module>
        <module>platform</module>
        <module>rinkreports</module>
        <module>rinkmetrics</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jsoup.version>1.23.2</jsoup.version>
        <openhtmltopdf.version>1.1.97</openhtmltopdf.version>
        <fastexcel.version>0.18.4</fastexcel.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- Docker Engine 29 exige Testcontainers 1.21.4 o posterior (la versión de Spring Boot no lo detecta). -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <build>
        <plugins>
            <!-- Tests unitarios: *Test (H2 en memoria). Tests de integración (PostgreSQL con Testcontainers/Docker): *IT -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!--
              Cobertura: el agente de JaCoCo instrumenta los tests unitarios (surefire) y los de integración
              (failsafe) sobre el mismo target/jacoco.exec de cada módulo. Va después de failsafe porque en una misma
              fase Maven ejecuta los plugins en el orden del POM. El reporte de todos los módulos lo arma app
              (report-aggregate).
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
