# Copiar a .env (fuera de git) y completar. En producción, cargar estas variables en la plataforma.
# Mails por SMTP. Resend: host smtp.resend.com, usuario "resend", clave = API key (permiso de solo envío alcanza).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
# Remitente: tiene que ser de un dominio verificado en Resend (madsportsapp.com).
MAIL_FROM=Mad Sports <info@madsportsapp.com>
# Dirección pública de la web (para los enlaces de los mails)
APP_BASE_URL=http://localhost:8080
# Análisis con IA (opcional)
GEMINI_API_KEY=
